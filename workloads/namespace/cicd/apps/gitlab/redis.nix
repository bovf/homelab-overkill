# GitLab Redis: managed directly by k3s, independently of the GitLab Helm release.
{...}: let
  name = "gitlab-redis-external";
  labels.app = name;
  probe = {
    exec.command = ["sh" "-ec" ''test "$(redis-cli ping)" = PONG''];
    timeoutSeconds = 5;
    periodSeconds = 10;
  };
in {
  services.k3s.manifests.gitlab-redis.content = [
    {
      apiVersion = "v1";
      kind = "PersistentVolumeClaim";
      metadata = {
        inherit name;
        namespace = "cicd";
      };
      spec = {
        accessModes = ["ReadWriteOnce"];
        storageClassName = "local-path";
        resources.requests.storage = "8Gi";
      };
    }
    {
      apiVersion = "v1";
      kind = "Service";
      metadata = {
        inherit name labels;
        namespace = "cicd";
        annotations = {
          "prometheus.io/scrape" = "true";
          "prometheus.io/port" = "9121";
        };
      };
      spec = {
        type = "ClusterIP";
        selector = labels;
        ports = [
          {
            name = "redis";
            port = 6379;
            targetPort = "redis";
          }
          {
            name = "metrics";
            port = 9121;
            targetPort = "metrics";
          }
        ];
      };
    }
    {
      apiVersion = "apps/v1";
      kind = "Deployment";
      metadata = {
        inherit name labels;
        namespace = "cicd";
      };
      spec = {
        replicas = 1;
        strategy.type = "Recreate";
        selector.matchLabels = labels;
        template = {
          metadata.labels = labels;
          spec = {
            automountServiceAccountToken = false;
            terminationGracePeriodSeconds = 60;
            securityContext = {
              runAsNonRoot = true;
              # Preserve ownership of the existing persistent data.
              runAsUser = 1001;
              runAsGroup = 1001;
              fsGroup = 1001;
              fsGroupChangePolicy = "OnRootMismatch";
            };
            containers = [
              {
                name = "redis";
                image = "docker.io/library/redis:7.2.17-bookworm@sha256:0312984fbfeb2ff1d4382ecef45b50e7d65478a6a58cf12ce28d6de7a4142e45";
                command = ["/bin/sh" "-ec"];
                args = [
                  ''
                    set -eu

                    : "''${REDISCLI_AUTH:?The existing GitLab Redis credential is required}"
                    # Keep credentials out of argv/logs; reject control characters before writing config.
                    if [ "$(printf '%s' "$REDISCLI_AUTH" | LC_ALL=C tr -d '[:cntrl:]')" != "$REDISCLI_AUTH" ]; then
                      echo "Redis password must not contain control characters." >&2
                      exit 1
                    fi
                    escaped=$(printf '%s' "$REDISCLI_AUTH" | sed 's/[\\"]/\\&/g')
                    umask 077
                    printf 'requirepass "%s"\n' "$escaped" > /tmp/redis-auth.conf

                    exec redis-server /tmp/redis-auth.conf \
                      --bind 0.0.0.0 --protected-mode yes \
                      --dir /data --appendonly yes --appendfsync everysec --save "" \
                      --maxmemory-policy noeviction \
                      --rename-command FLUSHDB "" --rename-command FLUSHALL ""
                  ''
                ];
                env = [
                  {
                    name = "REDISCLI_AUTH";
                    valueFrom.secretKeyRef = {
                      # Generated by the existing GitLab release; do not rotate/recreate.
                      name = "gitlab-redis-secret";
                      key = "secret";
                    };
                  }
                ];
                ports = [
                  {
                    name = "redis";
                    containerPort = 6379;
                  }
                ];
                startupProbe = probe // {failureThreshold = 60;};
                readinessProbe = probe;
                livenessProbe = probe;
                securityContext = {
                  allowPrivilegeEscalation = false;
                  readOnlyRootFilesystem = true;
                  capabilities.drop = ["ALL"];
                  seccompProfile.type = "RuntimeDefault";
                };
                resources = {
                  requests = {
                    cpu = "100m";
                    memory = "128Mi";
                  };
                  limits = {
                    cpu = "500m";
                    memory = "512Mi";
                  };
                };
                volumeMounts = [
                  {
                    name = "data";
                    mountPath = "/data";
                  }
                  {
                    name = "runtime";
                    mountPath = "/tmp";
                  }
                ];
              }
              {
                # Redis metrics for Prometheus.
                name = "metrics";
                image = "docker.io/oliver006/redis_exporter:v1.96.0@sha256:3d57b9eb142a62ffc600063606a41cd471cd53d81bed10be5b56b3a8918f2c26";
                env = [
                  {
                    name = "REDIS_ADDR";
                    value = "redis://127.0.0.1:6379";
                  }
                  {
                    name = "REDIS_PASSWORD";
                    valueFrom.secretKeyRef = {
                      name = "gitlab-redis-secret";
                      key = "secret";
                    };
                  }
                ];
                ports = [
                  {
                    name = "metrics";
                    containerPort = 9121;
                  }
                ];
                securityContext = {
                  allowPrivilegeEscalation = false;
                  readOnlyRootFilesystem = true;
                  capabilities.drop = ["ALL"];
                  seccompProfile.type = "RuntimeDefault";
                };
                resources = {
                  requests = {
                    cpu = "25m";
                    memory = "32Mi";
                  };
                  limits = {
                    cpu = "100m";
                    memory = "128Mi";
                  };
                };
              }
            ];
            volumes = [
              {
                name = "data";
                persistentVolumeClaim.claimName = name;
              }
              {
                name = "runtime";
                emptyDir = {
                  medium = "Memory";
                  sizeLimit = "1Mi";
                };
              }
            ];
          };
        };
      };
    }
  ];
}
