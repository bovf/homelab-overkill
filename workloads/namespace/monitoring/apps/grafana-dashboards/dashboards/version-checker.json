{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Containers tracked",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "fixed", "fixedColor": "blue"}
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "count(version_checker_is_latest_version)", "instant": true, "refId": "A"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Outdated",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "count(version_checker_is_latest_version == 0) or vector(0)", "instant": true, "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Up to date",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "green", "value": 0.9}
            ]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "count(version_checker_is_latest_version == 1) / count(version_checker_is_latest_version)", "instant": true, "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last scan",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {"mode": "fixed", "fixedColor": "blue"}
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "targets": [
        {"expr": "max(timestamp(version_checker_is_latest_version)) * 1000", "instant": true, "refId": "A"}
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Container versions",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 22, "w": 24, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "filterable": true}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Status"}, "properties": [
            {"id": "mappings", "value": [
              {"type": "value", "options": {"0": {"text": "OUTDATED", "color": "red", "index": 0}}},
              {"type": "value", "options": {"1": {"text": "up to date", "color": "green", "index": 1}}}
            ]},
            {"id": "custom.cellOptions", "value": {"type": "color-text"}}
          ]}
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Status", "desc": false}, {"displayName": "Namespace", "desc": false}]
      },
      "targets": [
        {"expr": "version_checker_is_latest_version", "instant": true, "format": "table", "refId": "A"}
      ],
      "transformations": [
        {"id": "organize", "options": {
          "excludeByName": {
            "Time": true, "__name__": true, "endpoint": true, "instance": true,
            "job": true, "service": true, "metrics_path": true, "prometheus": true,
            "image": true
          },
          "indexByName": {
            "namespace": 0,
            "pod": 1,
            "container": 2,
            "current_version": 3,
            "latest_version": 4,
            "Value": 5
          },
          "renameByName": {
            "namespace": "Namespace",
            "pod": "Pod",
            "container": "Container",
            "current_version": "Current",
            "latest_version": "Latest",
            "Value": "Status"
          }
        }}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["versions", "drift"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Version drift",
  "uid": "version-drift",
  "version": 1,
  "weekStart": ""
}
